# Copia este archivo como  .env.deploy  y llena los datos.
# .env.deploy está en .gitignore: no sube a GitHub. No lo compartas.
#
# Dónde sacar estos datos:
#   hPanel de Hostinger → Archivos → Cuentas FTP
#
# El servidor FTP suele verse como  ftp.warpfinance.co  o  145.x.x.x
FTP_HOST=
FTP_USER=
FTP_PASS=

# Carpeta del subdominio form.warpfinance.co dentro del servidor.
# Normalmente es  public_html/form  o  domains/warpfinance.co/public_html/form
# En hPanel → Archivos → Administrador de archivos puedes ver la ruta exacta.
FTP_DIR=public_html/form
